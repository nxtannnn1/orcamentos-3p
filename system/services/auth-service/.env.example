# ============================================================
# MICROSOFT ENTRA ID - INTERACTIVE LOGIN
# ============================================================
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=


# ============================================================
# MICROSOFT ENTRA ID - SERVICE PRINCIPAL
# Client Credentials / Backend → Microsoft Graph
# ============================================================
MICROSOFT_SERVICE_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_SERVICE_CLIENT_SECRET=


# ============================================================
# INTERNAL API
# n8n → auth-service
# ============================================================
N8N_API_KEY=


# ============================================================
# SHAREPOINT
# ============================================================
SHAREPOINT_SITE_ID=hostname,site-collection-id,web-id
SHAREPOINT_MATERIALS_LIST_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_NETWORK_CATALOG_LIST_ID=00000000-0000-0000-0000-000000000000


# ============================================================
# APPLICATION
# ============================================================
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=true
TEST_MESSAGE=Mensagem padrão


# ============================================================
# MICROSOFT GRAPH
# Optional: application.properties provides the default.
# ============================================================
# MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0


# ============================================================
# DATABASE - POSTGRESQL LAB
# ============================================================
DB_URL=jdbc:postgresql://localhost:5432/orcamentos
DB_USERNAME=orcamentos
DB_PASSWORD=