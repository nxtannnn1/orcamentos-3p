# Preencher localmente. Não usar o usuário administrativo orcamentos.
# API desabilita acesso aos dados se qualquer configuração obrigatória faltar.
DATABASE_URL=
# disable é aceito SOMENTE para PostgreSQL em loopback fora de produção.
DATABASE_TLS_MODE=verify-full
# Array JSON; sha256 contém o hash hexadecimal do token, nunca o token.
# Gere com scripts/generate-client-token.mjs; cada cliente precisa de token próprio.
API_CLIENTS_JSON=[]
