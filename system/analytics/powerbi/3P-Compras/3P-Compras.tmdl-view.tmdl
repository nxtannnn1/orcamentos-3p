			isHidden
			summarizeBy: none
			sourceColumn: Orcamento_ID

		column Item_Origem_ID
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: Item_Origem_ID

		column ID_Item_Importado
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: ID_Item_Importado

		column Numero_Item
			dataType: int64
			summarizeBy: none
			sourceColumn: Numero_Item

		column Preco_Unitario
			dataType: decimal
			formatString: R$ #,0.00
			summarizeBy: none
			sourceColumn: Preco_Unitario

		column Preco_Total
			dataType: decimal
			formatString: R$ #,0.00
			summarizeBy: sum
			sourceColumn: Preco_Total

		column Quantidade
			dataType: double
			summarizeBy: sum
			sourceColumn: Quantidade

		column Unidade
			dataType: string
			summarizeBy: none
			sourceColumn: Unidade

		column Unidade_Normalizada
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Unidade_Normalizada

		column AprovadoPor
			dataType: string
			summarizeBy: none
			sourceColumn: AprovadoPor

		column EmailAprovador
			dataType: string
			summarizeBy: none
			sourceColumn: EmailAprovador

		column Decisao_Id
			dataType: string
			summarizeBy: none
			sourceColumn: Decisao_Id

		column Correcao_Operacao_Id
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Correcao_Operacao_Id

		column Chave_Historico
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Chave_Historico

		column Created
			dataType: dateTime
			isHidden
			formatString: dd/mm/yyyy hh:nn
			summarizeBy: none
			sourceColumn: Created

		column Registro_Valido_Preco
			dataType: boolean
			summarizeBy: none
			sourceColumn: Registro_Valido_Preco

		column Tem_Rastreabilidade
			dataType: boolean
			summarizeBy: none
			sourceColumn: Tem_Rastreabilidade

		partition Historico = m
			mode: import
			source =
				let
				    Fonte = fnLerLista(ListaHistoricoId, "Id,Title,Material_OficialId,Fornecedor,Data_Orcamento,Data_Aprovacao,Codigo_Orcamento,Orcamento_OrigemId,Item_OrigemId,ID_Item_Importado,Numero_Item,Preco_Unitario,Preco_Total,Quantidade,Unidade,AprovadoPor,EmailAprovador,Decisao_Id,Correcao_Operacao_Id,Chave_Historico,Created"),
				    SemSinteticos = Table.SelectRows(Fonte, each not Text.StartsWith(Text.Upper(Text.From([Codigo_Orcamento]) ?? ""), "HOMOLOG-3P") and not Text.StartsWith(Text.Upper(Text.From([Title]) ?? ""), "HOMOLOG-3P")),
				    Renomeado = Table.RenameColumns(SemSinteticos, {{"Id", "ID"}, {"Material_OficialId", "Material_ID"}, {"Orcamento_OrigemId", "Orcamento_ID"}, {"Item_OrigemId", "Item_Origem_ID"}}),
				    Datas = Table.TransformColumns(Renomeado, {{"Data_Orcamento", fnDataBrasilia}, {"Data_Aprovacao", fnDataHoraBrasilia}, {"Created", fnDataHoraBrasilia}}),
				    DataReferencia = Table.AddColumn(Datas, "Data_Referencia", each [Data_Orcamento] ?? (if [Data_Aprovacao] <> null then DateTime.Date([Data_Aprovacao]) else if [Created] <> null then DateTime.Date([Created]) else null), type date),
				    ChaveFornecedor = Table.AddColumn(DataReferencia, "Fornecedor_Chave", each fnChaveFornecedor([Fornecedor]), type text),
				    Valido = Table.AddColumn(ChaveFornecedor, "Registro_Valido_Preco", each [Material_ID] <> null and Text.Trim([Fornecedor] ?? "") <> "" and ([Preco_Unitario] ?? 0) > 0 and ([Quantidade] ?? 0) > 0, type logical),
				    Rastreavel = Table.AddColumn(Valido, "Tem_Rastreabilidade", each Text.Trim([Decisao_Id] ?? "") <> "" and Text.Contains([EmailAprovador] ?? "", "@"), type logical),
				    UnidadeNormalizada = Table.AddColumn(Rastreavel, "Unidade_Normalizada", each Text.Upper(Text.Trim([Unidade] ?? "")), type text),
				    Tipos = Table.TransformColumnTypes(UnidadeNormalizada, {{"ID", Int64.Type}, {"Title", type text}, {"Material_ID", Int64.Type}, {"Fornecedor", type text}, {"Data_Orcamento", type date}, {"Data_Aprovacao", type datetime}, {"Codigo_Orcamento", type text}, {"Orcamento_ID", Int64.Type}, {"Item_Origem_ID", Int64.Type}, {"ID_Item_Importado", Int64.Type}, {"Numero_Item", Int64.Type}, {"Preco_Unitario", Currency.Type}, {"Preco_Total", Currency.Type}, {"Quantidade", type number}, {"Unidade", type text}, {"AprovadoPor", type text}, {"EmailAprovador", type text}, {"Decisao_Id", type text}, {"Correcao_Operacao_Id", type text}, {"Chave_Historico", type text}, {"Created", type datetime}})
				in
				    Tipos

	/// Fornecedores normalizados a partir de Itens, Histórico e Orçamentos.
	table Fornecedores

		column Fornecedor_Chave
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Fornecedor_Chave

		column Fornecedor
			dataType: string
			summarizeBy: none
			sourceColumn: Fornecedor

		partition Fornecedores = m
			mode: import
			source =
				let
				    Nomes = Table.Combine({Table.SelectColumns(Itens, {"Fornecedor"}), Table.SelectColumns(Historico, {"Fornecedor"}), Table.SelectColumns(Orcamentos, {"Fornecedor"})}),
				    ComChave = Table.AddColumn(Nomes, "Fornecedor_Chave", each fnChaveFornecedor([Fornecedor]), type text),
				    Validos = Table.SelectRows(ComChave, each [Fornecedor_Chave] <> null),
				    Agrupado = Table.Group(Validos, {"Fornecedor_Chave"}, {{"Fornecedor", each List.First(List.Sort(List.Distinct(List.Transform([Fornecedor], Text.Trim)))), type text}})
				in
				    Agrupado

	/// Calendário contínuo do primeiro ao último ano com dados.
	table Calendario
		dataCategory: Time

		column Date
			dataType: dateTime
			isKey
			isNameInferred
			isDataTypeInferred
			formatString: dd/mm/yyyy
			summarizeBy: none
			sourceColumn: [Date]

		column Ano
			dataType: int64
			isNameInferred
			isDataTypeInferred
			summarizeBy: none
			sourceColumn: [Ano]

		column Mes_Numero
			dataType: int64
			isHidden
			isNameInferred
			isDataTypeInferred
			summarizeBy: none
			sourceColumn: [Mes_Numero]

		column Ano_Mes
			dataType: int64
			isHidden
			isNameInferred
			isDataTypeInferred
			summarizeBy: none
			sourceColumn: [Ano_Mes]

		column Mes
			dataType: string
			isNameInferred
			isDataTypeInferred
			summarizeBy: none
			sourceColumn: [Mes]
			sortByColumn: Ano_Mes

		column Trimestre
			dataType: string
			isNameInferred
			isDataTypeInferred
			summarizeBy: none
			sourceColumn: [Trimestre]

		partition Calendario = calculated
			mode: import
			source =
				VAR _datas =
				    UNION (
				        SELECTCOLUMNS ( Historico, "d", Historico[Data_Referencia] ),
				        SELECTCOLUMNS ( Orcamentos, "d", Orcamentos[Data_Orcamento] )
				    )
				VAR _inicio = DATE ( YEAR ( COALESCE ( MINX ( _datas, [d] ), TODAY () ) ), 1, 1 )
				VAR _fim = DATE ( YEAR ( COALESCE ( MAXX ( _datas, [d] ), TODAY () ) ), 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( _inicio, _fim ),
				        "Ano", YEAR ( [Date] ),
				        "Mes_Numero", MONTH ( [Date] ),
				        "Ano_Mes", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Mes", FORMAT ( [Date], "mmm/yyyy" ),
				        "Trimestre", "T" & QUARTER ( [Date] ) & "/" & YEAR ( [Date] )
				    )

	/// Medidas do painel de compras 3P.
	table _Medidas

		/// Registros do histórico com material, fornecedor, preço e quantidade.
		measure 'Cotações Válidas' = CALCULATE ( COUNTROWS ( Historico ), Historico[Registro_Valido_Preco] = TRUE () )
			formatString: #,0
			displayFolder: 1 Preços

		measure 'Materiais Cotados' = CALCULATE ( DISTINCTCOUNT ( Historico[Material_ID] ), Historico[Registro_Valido_Preco] = TRUE () )
			formatString: #,0
			displayFolder: 1 Preços

		measure 'Fornecedores Cotados' = CALCULATE ( DISTINCTCOUNT ( Historico[Fornecedor_Chave] ), Historico[Registro_Valido_Preco] = TRUE () )
			formatString: #,0
			displayFolder: 1 Preços

		measure 'Preço Unitário Mínimo' = CALCULATE ( MIN ( Historico[Preco_Unitario] ), Historico[Registro_Valido_Preco] = TRUE () )
			formatString: R$ #,0.00
			displayFolder: 1 Preços

		measure 'Preço Unitário Máximo' = CALCULATE ( MAX ( Historico[Preco_Unitario] ), Historico[Registro_Valido_Preco] = TRUE () )
			formatString: R$ #,0.00
			displayFolder: 1 Preços

		/// Soma do preço total dividida pela soma das quantidades.
		measure 'Preço Unitário Médio Ponderado' =
				DIVIDE (
				    CALCULATE ( SUM ( Historico[Preco_Total] ), Historico[Registro_Valido_Preco] = TRUE () ),
				    CALCULATE ( SUM ( Historico[Quantidade] ), Historico[Registro_Valido_Preco] = TRUE () )
				)
			formatString: R$ #,0.00
			displayFolder: 1 Preços

		/// Menor preço unitário do mesmo material e período, entre todos os fornecedores.
		measure 'Preço Mínimo do Mercado' =
				CALCULATE (
				    [Preço Unitário Mínimo],
				    REMOVEFILTERS ( Fornecedores ),
				    REMOVEFILTERS ( Historico[Fornecedor], Historico[Fornecedor_Chave] )
				)
			formatString: R$ #,0.00
			displayFolder: 1 Preços

		measure 'Dispersão de Preço %' = DIVIDE ( [Preço Unitário Máximo] - [Preço Unitário Mínimo], [Preço Unitário Mínimo] )
			formatString: 0.0%
			displayFolder: 1 Preços

		measure 'Último Preço Unitário' =
				VAR _ultima = CALCULATE ( MAX ( Historico[Data_Referencia] ), Historico[Registro_Valido_Preco] = TRUE () )
				RETURN
				    CALCULATE ( [Preço Unitário Médio Ponderado], Historico[Data_Referencia] = _ultima )
			formatString: R$ #,0.00
			displayFolder: 1 Preços

		measure 'Fornecedor com Menor Preço' =
				VAR _minimo = [Preço Mínimo do Mercado]
				RETURN
				    CONCATENATEX (
				        CALCULATETABLE (
				            VALUES ( Historico[Fornecedor] ),
				            REMOVEFILTERS ( Fornecedores ),
				    REMOVEFILTERS ( Historico[Fornecedor], Historico[Fornecedor_Chave] ),
				            Historico[Registro_Valido_Preco] = TRUE (),
				            Historico[Preco_Unitario] = _minimo
				        ),
				        Historico[Fornecedor],
				        ", "
				    )
			displayFolder: 1 Preços

		measure 'Gasto Registrado' = CALCULATE ( SUM ( Historico[Preco_Total] ), Historico[Registro_Valido_Preco] = TRUE () )
			formatString: R$ #,0.00
			displayFolder: 2 Economia

		/// Quanto teria sido pago a menos comprando cada registro ao menor preço do mesmo material no período selecionado.
		measure 'Economia Potencial (R$)' =
				SUMX (
				    FILTER ( Historico, Historico[Registro_Valido_Preco] ),
				    VAR _material = Historico[Material_ID]
				    VAR _referencia =
				        CALCULATE (
				            MIN ( Historico[Preco_Unitario] ),
				            ALLSELECTED ( Historico ),
				            REMOVEFILTERS ( Fornecedores ),
				    REMOVEFILTERS ( Historico[Fornecedor], Historico[Fornecedor_Chave] ),
				            Historico[Material_ID] = _material,
				            Historico[Registro_Valido_Preco] = TRUE ()
				        )
				    RETURN
				        MAX ( 0, Historico[Preco_Unitario] - _referencia ) * Historico[Quantidade]
				)
			formatString: R$ #,0.00
			displayFolder: 2 Economia

		measure 'Economia Potencial (%)' = DIVIDE ( [Economia Potencial (R$)], [Gasto Registrado] )
			formatString: 0.0%
			displayFolder: 2 Economia

		measure 'Gasto ao Menor Preço' = [Gasto Registrado] - [Economia Potencial (R$)]
			formatString: R$ #,0.00
			displayFolder: 2 Economia

		/// 1,00 = sempre no menor preço do mercado; 1,15 = em média 15% acima (ponderado pela quantidade).
		measure 'Índice de Competitividade' =
				VAR _porMaterial =
				    ADDCOLUMNS (
				        CALCULATETABLE ( VALUES ( Historico[Material_ID] ), Historico[Registro_Valido_Preco] = TRUE () ),
				        "@quantidade", CALCULATE ( SUM ( Historico[Quantidade] ), Historico[Registro_Valido_Preco] = TRUE () ),
				        "@preco", [Preço Unitário Médio Ponderado],
				        "@referencia", [Preço Mínimo do Mercado]
				    )
				RETURN
				    DIVIDE (
				        SUMX ( _porMaterial, DIVIDE ( [@preco], [@referencia] ) * [@quantidade] ),
				        SUMX ( _porMaterial, [@quantidade] )
				    )
			formatString: 0.00
			displayFolder: 3 Fornecedores

		/// Materiais em que o fornecedor (no contexto) praticou o menor preço.
		measure 'Materiais com Menor Preço' =
				COUNTROWS (
				    FILTER (
				        CALCULATETABLE ( VALUES ( Historico[Material_ID] ), Historico[Registro_Valido_Preco] = TRUE () ),
				        [Preço Unitário Mínimo] <= [Preço Mínimo do Mercado]
				    )
				)
			formatString: #,0
			displayFolder: 3 Fornecedores

		measure 'Itens Importados' = COUNTROWS ( Itens ) + 0
			formatString: #,0
			displayFolder: 4 Qualidade

		measure 'Itens com Extração Completa' = CALCULATE ( COUNTROWS ( Itens ), Itens[Extracao_Completa] = TRUE () ) + 0
			formatString: #,0
			displayFolder: 4 Qualidade

		measure '% Extração Completa' = DIVIDE ( [Itens com Extração Completa], [Itens Importados] )
			formatString: 0.0%
			displayFolder: 4 Qualidade

		/// Quantidade × preço unitário difere do total em mais de R$ 0,01.
		measure 'Itens com Total Divergente' = CALCULATE ( COUNTROWS ( Itens ), Itens[Total_Divergente] = TRUE () ) + 0
			formatString: #,0
			displayFolder: 4 Qualidade

		measure 'Itens sem Fornecedor' = CALCULATE ( COUNTROWS ( Itens ), ISBLANK ( Itens[Fornecedor_Chave] ) ) + 0
			formatString: #,0
			displayFolder: 4 Qualidade

		measure 'Itens com Correção Humana' = CALCULATE ( COUNTROWS ( Itens ), Itens[Tem_Correcao] = TRUE () ) + 0
			formatString: #,0
			displayFolder: 4 Qualidade

		measure '% Itens com Correção' = DIVIDE ( [Itens com Correção Humana], [Itens Importados] )
			formatString: 0.0%
			displayFolder: 4 Qualidade

		measure 'Campos Corrigidos' = COUNTROWS ( CorrecoesCampos ) + 0
			formatString: #,0
			displayFolder: 4 Qualidade

		/// Entre aprovados com sugestão, % em que o material aprovado foi o sugerido.
		measure 'Acerto da Sugestão de Material' =
				VAR _comparaveis =
				    CALCULATE (
				        COUNTROWS ( Itens ),
				        Itens[Status_Revisao_Normalizado] = "APROVADO",
				        NOT ISBLANK ( Itens[Material_Sugerido_ID] ),
				        NOT ISBLANK ( Itens[Material_Aprovado_ID] )
				    )
				VAR _acertos =
				    COUNTROWS (
				        FILTER (
				            Itens,
				            Itens[Status_Revisao_Normalizado] = "APROVADO"
				                && NOT ISBLANK ( Itens[Material_Aprovado_ID] )
				                && Itens[Material_Sugerido_ID] = Itens[Material_Aprovado_ID]
				        )
				    )
				RETURN
				    DIVIDE ( _acertos, _comparaveis )
			formatString: 0.0%
			displayFolder: 4 Qualidade

		measure 'Itens Aprovados' = CALCULATE ( COUNTROWS ( Itens ), Itens[Status_Revisao_Normalizado] = "APROVADO" ) + 0
			formatString: #,0
			displayFolder: 5 Aprovações

		measure 'Itens Rejeitados' = CALCULATE ( COUNTROWS ( Itens ), Itens[Status_Revisao_Normalizado] = "REJEITADO" ) + 0
			formatString: #,0
			displayFolder: 5 Aprovações

		measure 'Itens Pendentes de Revisão' = CALCULATE ( COUNTROWS ( Itens ), Itens[Status_Revisao_Normalizado] IN { "PENDENTE", "EM_REVISAO", "CORRIGIR" } ) + 0
			formatString: #,0
			displayFolder: 5 Aprovações

		measure '% Itens Revisados' = DIVIDE ( [Itens Aprovados] + [Itens Rejeitados], [Itens Importados] )
			formatString: 0.0%
			displayFolder: 5 Aprovações

		measure 'Decisões Rastreáveis' = CALCULATE ( COUNTROWS ( Itens ), Itens[Origem_Decisao] = "Portal (rastreável)" ) + 0
			formatString: #,0
			displayFolder: 5 Aprovações

		measure 'Decisões Legadas sem Responsável' = CALCULATE ( COUNTROWS ( Itens ), Itens[Origem_Decisao] = "Legado sem responsável" ) + 0
			formatString: #,0
			displayFolder: 5 Aprovações

		measure '% Rastreabilidade das Decisões' = DIVIDE ( [Decisões Rastreáveis], [Decisões Rastreáveis] + [Decisões Legadas sem Responsável] )
			formatString: 0.0%
			displayFolder: 5 Aprovações

		measure 'Responsáveis Distintos' = CALCULATE ( DISTINCTCOUNT ( Itens[EmailAprovador] ), Itens[Decisao_Rastreavel] = TRUE () ) + 0
			formatString: #,0
			displayFolder: 5 Aprovações

		/// Da importação do orçamento até a decisão no portal.
		measure 'Dias Médios até a Decisão' =
				AVERAGEX (
				    FILTER ( Itens, NOT ISBLANK ( Itens[Data_Decisao] ) ),
				    VAR _importacao = RELATED ( Orcamentos[Data_Importacao] )
				    RETURN
				        IF ( NOT ISBLANK ( _importacao ), DATEDIFF ( _importacao, Itens[Data_Decisao], HOUR ) / 24 )
				)
			formatString: 0.0
			displayFolder: 5 Aprovações

		/// Aprovados ainda não enviados ao histórico (inclui aprovações legadas).
		measure 'Aprovados Aguardando Envio' =
				CALCULATE (
				    COUNTROWS ( Itens ),
				    Itens[Status_Revisao_Normalizado] = "APROVADO",
				    Itens[Enviado_Historico] = "NAO"
				) + 0
			formatString: #,0
			displayFolder: 6 Integridade

		measure 'Enviados sem Histórico' =
				VAR _comHistorico = CALCULATETABLE ( VALUES ( Historico[ID_Item_Importado] ), REMOVEFILTERS ( Historico ) )
				RETURN
				    COUNTROWS ( FILTER ( Itens, Itens[Enviado_Historico] = "SIM" && NOT ( Itens[ID] IN _comHistorico ) ) ) + 0
			formatString: #,0
			displayFolder: 6 Integridade

		measure 'Histórico sem Item de Origem' =
				VAR _itens = CALCULATETABLE ( VALUES ( Itens[ID] ), REMOVEFILTERS ( Itens ) )
				RETURN
				    COUNTROWS ( FILTER ( Historico, ISBLANK ( Historico[ID_Item_Importado] ) || NOT ( Historico[ID_Item_Importado] IN _itens ) ) ) + 0
			formatString: #,0
			displayFolder: 6 Integridade

		/// Sem material, fornecedor, preço ou quantidade: fora dos indicadores de preço.
		measure 'Histórico Incompleto' = CALCULATE ( COUNTROWS ( Historico ), Historico[Registro_Valido_Preco] = FALSE () ) + 0
			formatString: #,0
			displayFolder: 6 Integridade

		measure 'Histórico sem Rastreabilidade' = CALCULATE ( COUNTROWS ( Historico ), Historico[Tem_Rastreabilidade] = FALSE () ) + 0
			formatString: #,0
			displayFolder: 6 Integridade

		measure 'Decisão Divergente Item × Histórico' =
				COUNTROWS (
				    FILTER (
				        Historico,
				        VAR _decisaoItem = LOOKUPVALUE ( Itens[Decisao_Id], Itens[ID], Historico[ID_Item_Importado] )
				        RETURN
				            NOT ISBLANK ( Historico[Decisao_Id] ) && NOT ISBLANK ( _decisaoItem ) && _decisaoItem <> Historico[Decisao_Id]
				    )
				) + 0
			formatString: #,0
			displayFolder: 6 Integridade

		measure 'Chaves Duplicadas no Histórico' =
				VAR _comChave = FILTER ( Historico, NOT ISBLANK ( Historico[ID_Item_Importado] ) )
				RETURN
				    COUNTROWS ( _comChave ) - COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( _comChave, "k", Historico[ID_Item_Importado] ) ) ) + 0
			formatString: #,0
			displayFolder: 6 Integridade

		/// Preço comparado em unidade diferente da unidade padrão do material.
		measure 'Unidade Divergente do Padrão' =
				COUNTROWS (
				    FILTER (
				        Historico,
				        Historico[Registro_Valido_Preco]
				            && NOT ISBLANK ( RELATED ( Materiais[Unidade_Padrao] ) )
				            && Historico[Unidade_Normalizada] <> RELATED ( Materiais[Unidade_Padrao] )
				    )
				) + 0
			formatString: #,0
			displayFolder: 6 Integridade

		measure 'Material Fora do Catálogo' = COUNTROWS ( FILTER ( Historico, NOT ISBLANK ( Historico[Material_ID] ) && ISBLANK ( RELATED ( Materiais[ID] ) ) ) ) + 0
			formatString: #,0
			displayFolder: 6 Integridade

		/// Soma das verificações críticas (não inclui histórico legado incompleto ou sem rastreabilidade).
		measure 'Pendências de Integridade' =
				[Enviados sem Histórico] + [Histórico sem Item de Origem] + [Decisão Divergente Item × Histórico]
				    + [Chaves Duplicadas no Histórico] + [Unidade Divergente do Padrão] + [Material Fora do Catálogo] + 0
			formatString: #,0
			displayFolder: 6 Integridade

		/// Alerta exibido enquanto o histórico tiver poucas cotações válidas.
		measure 'Aviso de Base' =
				VAR _cotacoes = [Cotações Válidas] + 0
				RETURN
				    IF (
				        _cotacoes < 30,
				        "Base ainda pequena: " & _cotacoes & " cotação(ões) válida(s) no histórico. Interprete preços e economia com cautela."
				    )
			displayFolder: 0 Executivo

		column Coluna
			dataType: int64
			isHidden
			isNameInferred
			isDataTypeInferred
			summarizeBy: none
			sourceColumn: [Coluna]

		partition _Medidas = calculated
			mode: import
			source =
				ROW ( "Coluna", 0 )

	relationship historico_material
		fromColumn: Historico.Material_ID
		toColumn: Materiais.ID

	relationship historico_orcamento
		fromColumn: Historico.Orcamento_ID
		toColumn: Orcamentos.ID

	relationship historico_fornecedor
		fromColumn: Historico.Fornecedor_Chave
		toColumn: Fornecedores.Fornecedor_Chave

	relationship historico_data
		fromColumn: Historico.Data_Referencia
		toColumn: Calendario.Date

	relationship itens_orcamento
		fromColumn: Itens.Orcamento_ID
		toColumn: Orcamentos.ID

	relationship itens_material_aprovado
		fromColumn: Itens.Material_Aprovado_ID
		toColumn: Materiais.ID

	relationship itens_material_sugerido
		isActive: false
		fromColumn: Itens.Material_Sugerido_ID
		toColumn: Materiais.ID

	relationship itens_fornecedor
		fromColumn: Itens.Fornecedor_Chave
		toColumn: Fornecedores.Fornecedor_Chave

	relationship correcoes_item
		fromColumn: CorrecoesCampos.Item_ID
		toColumn: Itens.ID

