createOrReplace

	expression SharePointRaiz = "https://SEU-TENANT.sharepoint.com" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

	expression SiteCaminho = "sites/SEU-SITE" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

	expression ListaItensId = "00000000-0000-0000-0000-000000000001" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

	expression ListaOrcamentosId = "00000000-0000-0000-0000-000000000002" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

	expression ListaMateriaisId = "00000000-0000-0000-0000-000000000003" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

	expression ListaHistoricoId = "00000000-0000-0000-0000-000000000004" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]

	/// Lê uma lista SharePoint pela API REST (nomes internos), com paginação por odata.nextLink.
	expression fnLerLista =
			(listId as text, campos as text) as table =>
			let
			    Pagina = (consulta as record) as record =>
			        Json.Document(
			            Web.Contents(
			                SharePointRaiz,
			                [
			                    RelativePath = SiteCaminho & "/_api/web/lists(guid'" & listId & "')/items",
			                    Query = consulta,
			                    Headers = [Accept = "application/json;odata=nometadata"]
			                ]
			            )
			        ),
			    Paginas = List.Generate(
			        () => Pagina([#"$top" = "5000", #"$select" = campos]),
			        each _ <> null,
			        each if Record.HasFields(_, "odata.nextLink") then Pagina(Uri.Parts(Record.Field(_, "odata.nextLink"))[Query]) else null,
			        each _[value]
			    ),
			    Linhas = List.Combine(Paginas),
			    Tabela = Table.FromRecords(Linhas, Text.Split(campos, ","), MissingField.UseNull)
			in
			    Tabela

	/// Texto ISO-8601 (UTC) do SharePoint para data no fuso de Brasília (UTC-3).
	expression fnDataBrasilia =
			(valor as nullable text) as nullable date =>
			    if valor = null or valor = "" then null
			    else DateTime.Date(DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(valor), -3)))

	/// Texto ISO-8601 (UTC) do SharePoint para data e hora no fuso de Brasília (UTC-3).
	expression fnDataHoraBrasilia =
			(valor as nullable text) as nullable datetime =>
			    if valor = null or valor = "" then null
			    else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(valor), -3))

	/// Chave de fornecedor: maiúsculas, sem espaços duplicados nem pontuação simples.
	expression fnChaveFornecedor =
			(nome as any) as nullable text =>
			    let
			        Texto = Text.Upper(Text.Trim(Text.From(nome) ?? "")),
			        Partes = List.Select(Text.SplitAny(Texto, " .,-/"), each _ <> "")
			    in
			        if Texto = "" then null else Text.Combine(Partes, " ")

	/// Itens_Importados sem registros sintéticos (HOMOLOG-3P). Base de Itens e CorrecoesCampos; não é carregada.
	expression ItensBase =
			let
			    Fonte = fnLerLista(ListaItensId, "Id,Codigo_Item,Codigo_OrcamentoId,Numero_Item,Fornecedor,Descricao_Original,Quantidade,Unidade_Original,Preco_Unitario,Preco_Total,Status_Revisao,Enviado_Historico,Material_Sugerido_RefId,Material_AprovadoId,Data_Decisao,AprovadoPor,EmailAprovador,Decisao_Id,Correcao_Operacao_Id,Correcao_Humana_JSON,Responsavel_DecisaoId,Created"),
			    SemSinteticos = Table.SelectRows(Fonte, each not Text.StartsWith(Text.Upper(Text.From([Codigo_Item]) ?? ""), "HOMOLOG-3P"))
			in
			    SemSinteticos

	/// Catálogo Materiais_Oficiais (exclui Tipo_Registro = TESTE).
	table Materiais

		column ID
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: ID

		column Codigo
			dataType: string
			summarizeBy: none
			sourceColumn: Codigo

		column Material
			dataType: string
			summarizeBy: none
			sourceColumn: Material

		column Material_Rotulo
			dataType: string
			summarizeBy: none
			sourceColumn: Material_Rotulo

		column Familia
			dataType: string
			summarizeBy: none
			sourceColumn: Familia

		column Subfamilia
			dataType: string
			summarizeBy: none
			sourceColumn: Subfamilia

		column Categoria
			dataType: string
			summarizeBy: none
			sourceColumn: Categoria

		column Unidade_Padrao
			dataType: string
			summarizeBy: none
			sourceColumn: Unidade_Padrao

		column Status
			dataType: string
			summarizeBy: none
			sourceColumn: Status

		column Tipo_Registro
			dataType: string
			summarizeBy: none
			sourceColumn: Tipo_Registro

		column Origem_Catalogo
			dataType: string
			summarizeBy: none
			sourceColumn: Origem_Catalogo

		column Codigo_Neoenergia
			dataType: string
			summarizeBy: none
			sourceColumn: Codigo_Neoenergia

		partition Materiais = m
			mode: import
			source =
				let
				    Fonte = fnLerLista(ListaMateriaisId, "Id,Title,Material,Familia,Subfamilia,Categoria,Unidade_Padrao,Status,Tipo_Registro,Origem_Catalogo,Codigo_Neoenergia"),
				    SemTeste = Table.SelectRows(Fonte, each [Tipo_Registro] <> "TESTE"),
				    Renomeado = Table.RenameColumns(SemTeste, {{"Id", "ID"}, {"Title", "Codigo"}}),
				    Rotulo = Table.AddColumn(Renomeado, "Material_Rotulo", each if [Codigo] = null or Text.Trim([Codigo]) = Text.Trim([Material] ?? "") then [Material] else Text.Combine(List.RemoveNulls({[Codigo], [Material]}), " · "), type text),
				    Tipos = Table.TransformColumnTypes(Rotulo, {{"ID", Int64.Type}, {"Codigo", type text}, {"Material", type text}, {"Familia", type text}, {"Subfamilia", type text}, {"Categoria", type text}, {"Unidade_Padrao", type text}, {"Status", type text}, {"Tipo_Registro", type text}, {"Origem_Catalogo", type text}, {"Codigo_Neoenergia", type text}})
				in
				    Tipos

	/// Orçamentos importados (exclui HOMOLOG-3P).
	table Orcamentos

		column ID
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: ID

		column Codigo_Orcamento
			dataType: string
			summarizeBy: none
			sourceColumn: Codigo_Orcamento

		column Numero_Orcamento
			dataType: string
			summarizeBy: none
			sourceColumn: Numero_Orcamento

		column Fornecedor
			dataType: string
			summarizeBy: none
			sourceColumn: Fornecedor

		column Razao_Social
			dataType: string
			summarizeBy: none
			sourceColumn: Razao_Social

		column CNPJ_Fornecedor
			dataType: string
			summarizeBy: none
			sourceColumn: CNPJ_Fornecedor

		column Chave_Fornecedor
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Chave_Fornecedor

		column Data_Orcamento
			dataType: dateTime
			formatString: dd/mm/yyyy
			summarizeBy: none
			sourceColumn: Data_Orcamento

		column Data_Importacao
			dataType: dateTime
			formatString: dd/mm/yyyy hh:nn
			summarizeBy: none
			sourceColumn: Data_Importacao

		column Valor_Total
			dataType: decimal
			formatString: R$ #,0.00
			summarizeBy: sum
			sourceColumn: Valor_Total

		column Quantidade_Itens
			dataType: int64
			summarizeBy: sum
			sourceColumn: Quantidade_Itens

		column Fornecedor_Identificado
			dataType: boolean
			summarizeBy: none
			sourceColumn: Fornecedor_Identificado

		column Validacao_Orcamento
			dataType: string
			summarizeBy: none
			sourceColumn: Validacao_Orcamento

		column Status_Processamento
			dataType: string
			summarizeBy: none
			sourceColumn: Status_Processamento

		column Status_Revisao
			dataType: string
			summarizeBy: none
			sourceColumn: Status_Revisao

		column Status_Revisao_Normalizado
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Status_Revisao_Normalizado

		partition Orcamentos = m
			mode: import
			source =
				let
				    Fonte = fnLerLista(ListaOrcamentosId, "Id,Codigo_Orcamento,Numero_Orcamento,Fornecedor,Razao_Social,CNPJ_Fornecedor,Chave_Fornecedor,Data_Orcamento,Data_Importacao,Valor_Total,Quantidade_Itens,Fornecedor_Identificado,Validacao_Orcamento,Status_Processamento,Status_Revisao"),
				    SemSinteticos = Table.SelectRows(Fonte, each not Text.StartsWith(Text.Upper(Text.From([Codigo_Orcamento]) ?? ""), "HOMOLOG-3P")),
				    Renomeado = Table.RenameColumns(SemSinteticos, {{"Id", "ID"}}),
				    Datas = Table.TransformColumns(Renomeado, {{"Data_Orcamento", fnDataBrasilia}, {"Data_Importacao", fnDataHoraBrasilia}}),
				    StatusNormalizado = Table.AddColumn(Datas, "Status_Revisao_Normalizado", each Text.Upper(Text.Trim([Status_Revisao] ?? "")), type text),
				    Tipos = Table.TransformColumnTypes(StatusNormalizado, {{"ID", Int64.Type}, {"Codigo_Orcamento", type text}, {"Numero_Orcamento", type text}, {"Fornecedor", type text}, {"Razao_Social", type text}, {"CNPJ_Fornecedor", type text}, {"Chave_Fornecedor", type text}, {"Data_Orcamento", type date}, {"Data_Importacao", type datetime}, {"Valor_Total", Currency.Type}, {"Quantidade_Itens", Int64.Type}, {"Fornecedor_Identificado", type logical}, {"Validacao_Orcamento", type text}, {"Status_Processamento", type text}, {"Status_Revisao", type text}})
				in
				    Tipos

	/// Itens_Importados (exclui HOMOLOG-3P). Uma linha por item extraído de orçamento.
	table Itens

		column ID
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: ID

		column Codigo_Item
			dataType: string
			summarizeBy: none
			sourceColumn: Codigo_Item

		column Orcamento_ID
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: Orcamento_ID

		column Numero_Item
			dataType: int64
			summarizeBy: none
			sourceColumn: Numero_Item

		column Fornecedor
			dataType: string
			summarizeBy: none
			sourceColumn: Fornecedor

		column Fornecedor_Chave
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Fornecedor_Chave

		column Descricao_Original
			dataType: string
			summarizeBy: none
			sourceColumn: Descricao_Original

		column Quantidade
			dataType: double
			summarizeBy: sum
			sourceColumn: Quantidade

		column Unidade_Original
			dataType: string
			summarizeBy: none
			sourceColumn: Unidade_Original

		column Preco_Unitario
			dataType: decimal
			formatString: R$ #,0.00
			summarizeBy: none
			sourceColumn: Preco_Unitario

		column Preco_Total
			dataType: decimal
			formatString: R$ #,0.00
			summarizeBy: sum
			sourceColumn: Preco_Total

		column Status_Revisao
			dataType: string
			summarizeBy: none
			sourceColumn: Status_Revisao

		column Status_Revisao_Normalizado
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Status_Revisao_Normalizado

		column Enviado_Historico
			dataType: string
			summarizeBy: none
			sourceColumn: Enviado_Historico

		column Material_Sugerido_ID
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: Material_Sugerido_ID

		column Material_Aprovado_ID
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: Material_Aprovado_ID

		column Data_Decisao
			dataType: dateTime
			formatString: dd/mm/yyyy hh:nn
			summarizeBy: none
			sourceColumn: Data_Decisao

		column AprovadoPor
			dataType: string
			summarizeBy: none
			sourceColumn: AprovadoPor

		column EmailAprovador
			dataType: string
			summarizeBy: none
			sourceColumn: EmailAprovador

		column Decisao_Id
			dataType: string
			summarizeBy: none
			sourceColumn: Decisao_Id

		column Correcao_Operacao_Id
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Correcao_Operacao_Id

		column Responsavel_Legado_ID
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: Responsavel_Legado_ID

		column Created
			dataType: dateTime
			formatString: dd/mm/yyyy hh:nn
			summarizeBy: none
			sourceColumn: Created

		column Tem_Correcao
			dataType: boolean
			summarizeBy: none
			sourceColumn: Tem_Correcao

		column Extracao_Completa
			dataType: boolean
			summarizeBy: none
			sourceColumn: Extracao_Completa

		column Total_Divergente
			dataType: boolean
			summarizeBy: none
			sourceColumn: Total_Divergente

		column Decisao_Rastreavel
			dataType: boolean
			summarizeBy: none
			sourceColumn: Decisao_Rastreavel

		column Origem_Decisao
			dataType: string
			summarizeBy: none
			sourceColumn: Origem_Decisao

		partition Itens = m
			mode: import
			source =
				let
				    Fonte = Table.RemoveColumns(ItensBase, {"Correcao_Humana_JSON"}),
				    Renomeado = Table.RenameColumns(Fonte, {{"Id", "ID"}, {"Codigo_OrcamentoId", "Orcamento_ID"}, {"Material_Sugerido_RefId", "Material_Sugerido_ID"}, {"Material_AprovadoId", "Material_Aprovado_ID"}, {"Responsavel_DecisaoId", "Responsavel_Legado_ID"}}),
				    Datas = Table.TransformColumns(Renomeado, {{"Data_Decisao", fnDataHoraBrasilia}, {"Created", fnDataHoraBrasilia}}),
				    StatusNormalizado = Table.AddColumn(Datas, "Status_Revisao_Normalizado", each Text.Upper(Text.Trim([Status_Revisao] ?? "")), type text),
				    ChaveFornecedor = Table.AddColumn(StatusNormalizado, "Fornecedor_Chave", each fnChaveFornecedor([Fornecedor]), type text),
				    TemCorrecao = Table.AddColumn(ChaveFornecedor, "Tem_Correcao", each Text.Trim([Correcao_Operacao_Id] ?? "") <> "", type logical),
				    ExtracaoCompleta = Table.AddColumn(TemCorrecao, "Extracao_Completa", each Text.Trim([Descricao_Original] ?? "") <> "" and Text.Trim([Fornecedor] ?? "") <> "" and Text.Trim([Unidade_Original] ?? "") <> "" and ([Quantidade] ?? 0) > 0 and ([Preco_Unitario] ?? 0) > 0 and ([Preco_Total] ?? 0) > 0, type logical),
				    TotalDivergente = Table.AddColumn(ExtracaoCompleta, "Total_Divergente", each [Quantidade] <> null and [Preco_Unitario] <> null and [Preco_Total] <> null and Number.Abs([Quantidade] * [Preco_Unitario] - [Preco_Total]) > 0.01, type logical),
				    Rastreavel = Table.AddColumn(TotalDivergente, "Decisao_Rastreavel", each Text.Trim([Decisao_Id] ?? "") <> "" and Text.Contains([EmailAprovador] ?? "", "@"), type logical),
				    OrigemDecisao = Table.AddColumn(Rastreavel, "Origem_Decisao", each if List.Contains({"APROVADO", "REJEITADO"}, [Status_Revisao_Normalizado]) then (if [Decisao_Rastreavel] then "Portal (rastreável)" else "Legado sem responsável") else "Sem decisão", type text),
				    Tipos = Table.TransformColumnTypes(OrigemDecisao, {{"ID", Int64.Type}, {"Codigo_Item", type text}, {"Orcamento_ID", Int64.Type}, {"Numero_Item", Int64.Type}, {"Fornecedor", type text}, {"Descricao_Original", type text}, {"Quantidade", type number}, {"Unidade_Original", type text}, {"Preco_Unitario", Currency.Type}, {"Preco_Total", Currency.Type}, {"Status_Revisao", type text}, {"Enviado_Historico", type text}, {"Material_Sugerido_ID", Int64.Type}, {"Material_Aprovado_ID", Int64.Type}, {"Data_Decisao", type datetime}, {"AprovadoPor", type text}, {"EmailAprovador", type text}, {"Decisao_Id", type text}, {"Correcao_Operacao_Id", type text}, {"Responsavel_Legado_ID", Int64.Type}, {"Created", type datetime}})
				in
				    Tipos

	/// Campos alterados nas correções humanas (Correcao_Humana_JSON.changes).
	table CorrecoesCampos

		column Item_ID
			dataType: int64
			isHidden
			summarizeBy: none
			sourceColumn: Item_ID

		column Operacao_Id
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Operacao_Id

		column Corrigido_Por
			dataType: string
			summarizeBy: none
			sourceColumn: Corrigido_Por

		column Corrigido_Em
			dataType: dateTime
			formatString: dd/mm/yyyy hh:nn
			summarizeBy: none
			sourceColumn: Corrigido_Em

		column Campo
			dataType: string
			isHidden
			summarizeBy: none
			sourceColumn: Campo

		column Campo_Rotulo
			dataType: string
			summarizeBy: none
			sourceColumn: Campo_Rotulo

		column Valor_Extraido
			dataType: string
			summarizeBy: none
			sourceColumn: Valor_Extraido

		column Valor_Anterior
			dataType: string
			summarizeBy: none
			sourceColumn: Valor_Anterior

		column Valor_Corrigido
			dataType: string
			summarizeBy: none
			sourceColumn: Valor_Corrigido

		partition CorrecoesCampos = m
			mode: import
			source =
				let
				    Fonte = Table.SelectColumns(ItensBase, {"Id", "Correcao_Humana_JSON"}),
				    ComRegistro = Table.SelectRows(Fonte, each Text.Trim([Correcao_Humana_JSON] ?? "") <> ""),
				    Registro = Table.AddColumn(ComRegistro, "Registro", each try Json.Document([Correcao_Humana_JSON]) otherwise null),
				    Validos = Table.SelectRows(Registro, each [Registro] is record),
				    Dados = Table.AddColumn(Validos, "Dados", each [
				        Corrigido_Por = try Text.From([Registro][approver][name]) otherwise null,
				        Corrigido_Em = try fnDataHoraBrasilia([Registro][at]) otherwise null,
				        Operacao_Id = try Text.From([Registro][operationId]) otherwise null,
				        Mudancas = try List.Select([Registro][changes], each _ is record) otherwise {}
				    ]),
				    Expandido = Table.ExpandRecordColumn(Dados, "Dados", {"Corrigido_Por", "Corrigido_Em", "Operacao_Id", "Mudancas"}),
				    PorCampo = Table.ExpandListColumn(Expandido, "Mudancas"),
				    ComCampo = Table.SelectRows(PorCampo, each [Mudancas] is record),
				    Campos = Table.ExpandRecordColumn(ComCampo, "Mudancas", {"field", "previous", "value", "extracted"}, {"Campo", "Valor_Anterior", "Valor_Corrigido", "Valor_Extraido"}),
				    Rotulo = Table.AddColumn(Campos, "Campo_Rotulo", each Record.FieldOrDefault([description = "Descrição", quantity = "Quantidade", unit = "Unidade", unitPrice = "Preço unitário", totalPrice = "Preço total", supplier = "Fornecedor", materialId = "Material", observation = "Observação"], [Campo] ?? "", [Campo]), type text),
				    Textos = Table.TransformColumns(Rotulo, {{"Valor_Anterior", each Text.From(_), type text}, {"Valor_Corrigido", each Text.From(_), type text}, {"Valor_Extraido", each Text.From(_), type text}}),
				    Selecionado = Table.SelectColumns(Textos, {"Id", "Operacao_Id", "Corrigido_Por", "Corrigido_Em", "Campo", "Campo_Rotulo", "Valor_Extraido", "Valor_Anterior", "Valor_Corrigido"}),
				    Renomeado = Table.RenameColumns(Selecionado, {{"Id", "Item_ID"}}),
				    Tipos = Table.TransformColumnTypes(Renomeado, {{"Item_ID", Int64.Type}, {"Operacao_Id", type text}, {"Corrigido_Por", type text}, {"Corrigido_Em", type datetime}, {"Campo", type text}})
				in
				    Tipos

	/// Historico_Precos (exclui HOMOLOG-3P). Registro_Valido_Preco = material, fornecedor, preço e quantidade presentes.
	table Historico

		column ID
