{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "operator-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DATA_SOURCE": "mock"
  }
}
