DATA_SOURCE=mock
# Obsoleto desde 23/10/2026: o aprovador é gravado em texto (approverName/approverEmail no mapa de campos).
# Mantido apenas para referência; a factory ignora este valor.
SHAREPOINT_PERSON_RESOLVER=disabled
ENTRA_PERSON_READONLY_PROBE=false
# Pré-check opcional de schema/auditoria no mesmo probe local; nunca autoriza escrita.
ENTRA_DECISION_READONLY_PREFLIGHT=false
# Valor preparado: graph-list-permissions (pares Graph V2 explícitos; sem busca por email).
# Alternativa de consulta: DATA_SOURCE=operator-api
OPERATOR_API_BASE_URL=http://127.0.0.1:3001
OPERATOR_API_TOKEN=
# Somente desenvolvimento local, perfil Consulta; exige AUTH_DISABLED=true,
# frontend e API em HTTP loopback. Em produção, usar login Microsoft.
ALLOW_LOCAL_OPERATOR_API_BYPASS=false
# Development only. Allows read-only access to real SharePoint data
# while authentication is bypassed locally. Never enable in production.
ALLOW_LOCAL_SHAREPOINT_BYPASS=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_ORCAMENTOS_LIST_ID=
SHAREPOINT_ITENS_IMPORTADOS_LIST_ID=
SHAREPOINT_MATERIAIS_OFICIAIS_LIST_ID=
# Fase M: campos de autoria candidatos em docs/phase-m-decision-fields.candidate.json.
# Mesclar em items somente após validação; não substituir o mapa completo nem habilitar escrita.
SHAREPOINT_FIELD_MAP_JSON=

# Login corporativo: registro Entra separado da integração Graph acima.
# Valores preenchidos pelo administrador; nunca usar NEXT_PUBLIC_ para secrets.
ENTRA_LOGIN_TENANT_ID=
ENTRA_LOGIN_CLIENT_ID=
ENTRA_LOGIN_CLIENT_SECRET=
AUTH_APP_ORIGIN=http://localhost:3000
AUTH_SESSION_SECRET=
# ID do contexto publicado e vinculado à política MFA pelo administrador.
ENTRA_MFA_AUTH_CONTEXT_ID=

# Redis REST compartilhado e autoritativo: obrigatório em produção.
# Não usar endpoint de réplica/read-only. Memória só em development/test.
SECURITY_REDIS_REST_URL=
SECURITY_REDIS_REST_TOKEN=

# Provedor alternativo: desligado até homologação. Sem valores de produção locais.
KEYCLOAK_ENABLED=false
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Entrada única corporativa: manter desligada até aprovar/homologar política do broker.
# Exige claim identity_provider server-owned no ID token; hint não é autorização.
AUTH_CORPORATE_LOGIN_ENABLED=false
KEYCLOAK_CORPORATE_IDP_ALIAS=
