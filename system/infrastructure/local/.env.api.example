# Copie para .env.api (ignorado pelo Git). Nao reutilize credenciais administrativas.
DATABASE_URL=
DATABASE_TLS_MODE=verify-full
API_CLIENTS_JSON=[]
# Token de cliente dedicado ao probe, com hash registrado em API_CLIENTS_JSON.
API_PROBE_TOKEN=
# Se usar CA privada, monte apenas o certificado publico e configure NODE_EXTRA_CA_CERTS.
# Nunca use NODE_TLS_REJECT_UNAUTHORIZED=0.
