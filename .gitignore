# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/

# n8n local backups
system/automation/n8n/backups/

# Local backups / synchronization
.sync-backup/

# Local service environments and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Secrets and credentials
**/*secret*
**/*secrets*
**/*credential*
**/*credentials*
!**/*secret*.example*
!**/*secrets*.example*

# Private keys and certificates
**/*.pem
**/*.key
**/*.pkcs12
**/*.pfx
**/*.jks

# Database local lab
database-lab/

# Node / Prisma local dependencies
system/database/node_modules/

# SQLite local databases
system/database/**/*.db
system/database/**/*.db-journal
system/database/**/*.sqlite
system/database/**/*.sqlite3

# Prisma generated local artifacts
system/database/prisma/dev.db

# Service build artifacts
system/services/**/target/
system/services/**/build/

# Service IDE artifacts
system/services/**/.idea/
system/services/**/.vscode/
system/services/**/*.iml
system/services/**/*.iws
system/services/**/*.ipr

# Arquivos temporarios e evidencias locais
/work/

# Power BI: data-bearing files and Desktop local state (the filled copy lives outside the repo)
**/*.pbix
**/*.pbit
**/*.abf
**/.pbi/localSettings.json
**/.pbi/cache.abf
system/analytics/powerbi/**/*.local.*

# Power Automate: only reviewed sanitized definitions belong in Git.
system/automation/power-automate/**/*.zip
system/automation/power-automate/**/*.xml
system/automation/power-automate/**/raw/
system/automation/power-automate/**/exports/
system/automation/power-automate/**/*.local.*
system/automation/power-automate/flows/*
!system/automation/power-automate/flows/*.sanitized.json

# Microsoft Lists: deny files by default; only reviewed metadata and tooling.
system/infrastructure/microsoft-lists/**
!system/infrastructure/microsoft-lists/**/
!system/infrastructure/microsoft-lists/README.md
!system/infrastructure/microsoft-lists/*/README.md
!system/infrastructure/microsoft-lists/*/*.schema.json
!system/infrastructure/microsoft-lists/scripts/*.mjs
# Never re-include raw/private folders or backup copies via the rules above.
!system/infrastructure/microsoft-lists/arquivos-processados/*/README.md
!system/infrastructure/microsoft-lists/arquivos-processados/*/schema.json
system/infrastructure/microsoft-lists/**/exports-local/
system/infrastructure/microsoft-lists/**/raw/
system/infrastructure/microsoft-lists/**/exports/
system/infrastructure/microsoft-lists/**/backups/
system/infrastructure/microsoft-lists/**/backup/
system/infrastructure/microsoft-lists/**/*.local.*
system/infrastructure/microsoft-lists/**/*.bak.*
system/infrastructure/microsoft-lists/**/*.backup.*
